lue="73"/><column index="2" value="76"/><column index="3" value="127"/><column index="4" value="47"/><column index="5" value="95"/><column index="6" value="81"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="venta" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="58"/><column index="2" value="64"/><column index="3" value="81"/><column index="4" value="159"/><column index="5" value="55"/><column index="6" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT pr.razon_social
FROM proveedor pr
WHERE NOT EXISTS (
    SELECT 1
    FROM variante va
    JOIN producto p ON p.id_producto = va.id_producto
    WHERE p.nombre = 'Camiseta Oficial Deportivo'
      AND NOT EXISTS (
          SELECT 1
          FROM compra co
          JOIN detalle_compra dc ON dc.id_compra = co.id_compra
          WHERE co.id_proveedor = pr.id_proveedor
            AND dc.id_variante  = va.id_variante
      )
);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
